{
  "name": "@takeoff-ui/angular",
  "version": "0.11.2",
  "scripts": {
    "build": "ng-packagr -p ng-package.json"
  },
  "main": "./dist/fesm2022/takeoff-ui-angular.mjs",
  "module": "./dist/fesm2022/takeoff-ui-angular.mjs",
  "typings": "./dist/types/takeoff-ui-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
