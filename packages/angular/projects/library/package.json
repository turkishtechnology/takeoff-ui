    ".": {
      "types": "./dist/types/takeoff-ui-angular.d.ts",
      "default": "./dist/fesm2022/takeoff-ui-angular.mjs"
    }
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
