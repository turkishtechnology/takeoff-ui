{
  "name": "TkTextarea",
  "componentName": "TkTextarea",
  "hasChildren": false,
  "props": [
    {
      "key": "label",
      "label": "Label",
      "type": "text",
      "defaultValue": "Textarea Label"
    },
    {
      "key": "placeholder",
      "label": "Placeholder",
      "type": "text",
      "defaultValue": "Enter text here..."
    },
    {
      "key": "value",
      "label": "Value",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "size",
      "label": "Size",
      "type": "select",
      "defaultValue": "base",
      "options": [
        { "label": "Small", "value": "small" },
        { "label": "Base", "value": "base" },
        { "label": "Large", "value": "large" }
      ]
    },
    {
      "key": "rows",
      "label": "Rows",
      "type": "text",
      "defaultValue": 3
    },
    {
      "key": "maxLength",
      "label": "Max Length",
      "type": "text",
      "defaultValue": 100
    },
    {
      "key": "hint",
      "label": "Hint",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "error",
      "label": "Error",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "disabled",
      "label": "Disabled",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "readonly",
      "label": "Readonly",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "invalid",
      "label": "Invalid",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "showAsterisk",
      "label": "Show Asterisk",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "showCopyButton",
      "label": "Show Copy Button",
      "type": "checkbox",
      "defaultValue": false
    }
  ]
}
