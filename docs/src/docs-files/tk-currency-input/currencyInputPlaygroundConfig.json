{
  "name": "TkCurrencyInput",
  "componentName": "TkCurrencyInput",
  "hasChildren": false,
  "props": [
    {
      "key": "size",
      "label": "Size",
      "type": "select",
      "defaultValue": "base",
      "options": [
        { "label": "Small", "value": "small" },
        { "label": "Base", "value": "base" },
        { "label": "Large", "value": "large" }
      ]
    },
    {
      "key": "placeholder",
      "label": "Placeholder",
      "type": "text",
      "defaultValue": "Enter amount"
    },
    {
      "key": "defaultCurrency",
      "label": "Default Currency",
      "type": "text",
      "defaultValue": "TRY"
    },
    {
      "key": "dropdownWidthMode",
      "label": "Dropdown Width",
      "type": "select",
      "defaultValue": "match-parent",
      "options": [
        { "label": "Match Parent", "value": "match-parent" },
        { "label": "Auto", "value": "auto" }
      ]
    },
    {
      "key": "label",
      "label": "Label",
      "type": "text",
      "defaultValue": "Amount"
    },
    {
      "key": "hint",
      "label": "Hint",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "error",
      "label": "Error",
      "type": "text",
      "defaultValue": "",
      "tooltip": "It is recommended to use with invalid prop."
    },
    {
      "key": "decimalSeparator",
      "label": "Decimal Separator",
      "type": "text",
      "defaultValue": null
    },
    {
      "key": "thousandsSeparator",
      "label": "Thousands Separator",
      "type": "text",
      "defaultValue": null
    },
    {
      "key": "precision",
      "label": "Precision",
      "type": "text",
      "defaultValue": 2
    },
    {
      "key": "min",
      "label": "Min",
      "type": "text",
      "defaultValue": null
    },
    {
      "key": "max",
      "label": "Max",
      "type": "text",
      "defaultValue": null
    },
    {
      "key": "maxIntegerDigits",
      "label": "Max Integer Digits",
      "type": "text",
      "defaultValue": null
    },
    {
      "key": "currencyList",
      "label": "Currency List",
      "type": "json",
      "defaultValue": [
        { "code": "GBP", "id": "GB", "symbol": "£", "name": "British Pound", "decimalSeparator": ".", "thousandsSeparator": "," },
        { "code": "TRY", "id": "TR", "symbol": "₺", "name": "Turkish Lira", "decimalSeparator": ",", "thousandsSeparator": "." },
        { "code": "JPY", "id": "JP", "symbol": "¥", "name": "Japanese Yen", "decimalSeparator": ".", "thousandsSeparator": "," }
      ]
    },
    {
      "key": "disabled",
      "label": "Disabled",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "readonly",
      "label": "Readonly",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "invalid",
      "label": "Invalid",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "showAsterisk",
      "label": "Show Asterisk",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "currencyDisabled",
      "label": "Currency Disabled",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "allowNegative",
      "label": "Allow Negative",
      "type": "checkbox",
      "defaultValue": false
    }
  ]
}
