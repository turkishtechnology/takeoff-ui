{
  "name": "TkSelect",
  "componentName": "TkSelect",
  "hasChildren": false,
  "props": [
    {
      "key": "options",
      "label": "Options",
      "type": "json",
      "defaultValue": [
        { "label": "Option 1", "value": "1" },
        { "label": "Option 2", "value": "2" },
        { "label": "Option 3", "value": "3" }
      ]
    },
    {
      "key": "label",
      "label": "Label",
      "type": "text",
      "defaultValue": "Select Option"
    },
    {
      "key": "placeholder",
      "label": "Placeholder",
      "type": "text",
      "defaultValue": "Choose..."
    },
    {
      "key": "size",
      "label": "Size",
      "type": "select",
      "defaultValue": "base",
      "options": [
        { "label": "Small", "value": "small" },
        { "label": "Base", "value": "base" },
        { "label": "Large", "value": "large" }
      ]
    },
    {
      "key": "dropdownWidthMode",
      "label": "Dropdown Width Mode",
      "type": "text",
      "defaultValue": "match-parent",
      "tooltip": "Accepts 'match-parent', 'auto', or a pixel value (e.g. '200px')."
    },
    {
      "key": "icon",
      "label": "Icon",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "hint",
      "label": "Hint",
      "type": "text",
      "defaultValue": ""
    },
    {
      "key": "error",
      "label": "Error",
      "type": "text",
      "defaultValue": "",
      "tooltip": "It is recommended to use with invalid prop."
    },
    {
      "key": "emptyMessage",
      "label": "Empty Message",
      "type": "text",
      "defaultValue": "No options available"
    },
    {
      "key": "visibleItemCount",
      "label": "Visible Item Count",
      "type": "text",
      "defaultValue": "",
      "tooltip": "This feature works only when the `multiple` prop is enabled. Accepts numeric values."
    },
    {
      "key": "selectAllLabel",
      "label": "Select All Label",
      "type": "text",
      "defaultValue": "All",
      "tooltip": "This feature works only when the `multiple` prop is enabled."
    },
    {
      "key": "disabled",
      "label": "Disabled",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "readonly",
      "label": "Readonly",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "invalid",
      "label": "Invalid",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "clearable",
      "label": "Clearable",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "multiple",
      "label": "Multiple",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "showAsterisk",
      "label": "Show Asterisk",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "loading",
      "label": "Loading",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "allowCustomValue",
      "label": "Allow Custom Value",
      "type": "checkbox",
      "defaultValue": false
    },
    {
      "key": "selectAll",
      "label": "Select All",
      "type": "checkbox",
      "defaultValue": false,
      "tooltip": "This feature works only when the `multiple` prop is enabled."
    },
    {
      "key": "showSelectAllChip",
      "label": "Show Select All Chip",
      "type": "checkbox",
      "defaultValue": false,
      "tooltip": "Collapses the selection into a single chip labelled with `selectAllLabel` once every option is selected. Works only when the `multiple` and `selectAll` props are enabled. Has no effect when `allowCustomValue` is enabled, where every selected value keeps its own chip."
    },
    {
      "key": "editable",
      "label": "Editable",
      "type": "checkbox",
      "defaultValue": false
    }
  ]
}
